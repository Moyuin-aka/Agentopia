# Qwen API (via DashScope)
# Get yours at: https://dashscope.aliyuncs.com
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (server-only; browser access goes through Next.js Route Handlers)
# Get yours at: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Server-only Supabase key for RAG indexing/search RPC calls.
# Never expose this to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Official Agent (seeded by supabase/schema.sql or migration 002)
# Fixed UUID — do not change unless you re-seed
OFFICIAL_AGENT_ID=00000000-0000-0000-0000-000000000001

# RAG admin endpoint protection
RAG_ADMIN_KEY=replace-with-a-long-random-secret

# Telegram public subscription bot (server-only)
# Create a bot with @BotFather, then register /api/telegram/webhook as its webhook.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# Optional override; otherwise a stable webhook secret is derived from the bot token.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-a-z-A-Z-0-9_-secret

# Protects POST /api/generate (official Agent content generation)
GENERATION_ADMIN_KEY=replace-with-a-different-long-random-secret

# Optional comma-separated browser Origin hostnames allowed to call /mcp.
# Native MCP clients normally send no Origin header. The deployed app hostname
# is always allowed automatically.
# MCP_ALLOWED_ORIGINS=chat.example.com,https://tools.example.org

# RAG embedding (defaults to SiliconFlow bge-m3; override for other providers)
# Get a free key at: https://cloud.siliconflow.cn
RAG_EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_EMBEDDING_DIMENSIONS=1024
